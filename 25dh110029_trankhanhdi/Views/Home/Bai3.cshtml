@{
    Layout = null;
}
<html lang="vi">
<head>
    <script src="~/Scripts/MyJS/Bai3.js"></script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đồng hồ kỹ thuật số</title>
    <style>
        body {
            background-color: #f4f4f4;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
            font-family: Arial, sans-serif;
        }


        .clock-container {
            background-color: #000000;
            padding: 40px 80px;
            border-radius: 4px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
        }


        .clock-text {
            color: #00e5ff;
            font-size: 80px;
            font-family: 'Times New Roman', Times, serif;
            letter-spacing: 2px;
            text-align: center;
        }
    </style>
</head>
<body>

    <div class="clock-container">
        <div id="clock" class="clock-text">00:00:00 AM</div>
    </div>



</body>
</html>